{
  "name": "ecumene",
  "version": "0.2.0",
  "private": true,
  "description": "Paint countries on an accurate, draggable 3D globe. Open source.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "fetch": "sh scripts/fetch_data.sh",
    "data": "node scripts/build_tris.js 4 && node scripts/build_phys.js && node scripts/build_admin1.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --dev && node tests/server.js",
    "serve": "node tests/server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.*\"",
    "test:e2e": "playwright test",
    "format": "prettier --write src/js tests"
  },
  "dependencies": {
    "d3": "^7",
    "earcut": "2.2.4",
    "topojson-client": "^3",
    "topojson-server": "^3.0.1",
    "world-atlas": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.24.2",
    "prettier": "^3.3.3"
  }
}
